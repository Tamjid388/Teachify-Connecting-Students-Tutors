model Blog {
  id          String        @id @default(uuid())
  title       String
  slug        String   @unique
  content     String
  excerpt     String?  
  thumbnail   String?  
  authorId    String
  authorRole  Role     
  status      String   
  tags        String[] 
  readTime    Int?     
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}